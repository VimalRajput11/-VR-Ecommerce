# VG Unisex Salon — environment variables
# Copy to .env.local for development. Never commit real values.

# --- Required ---------------------------------------------------------------
# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/vg_saloon

# Public URL of the site (used for metadata/canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Extra allowed origins for state-changing API requests (comma-separated).
# The site's own host is always allowed; set this when behind a proxy/CDN with a different host.
APP_ORIGIN=

# --- File uploads -----------------------------------------------------------
# On Vercel: connect a Blob store to the project (Storage tab) — this token is then added
# automatically and uploads go to Vercel Blob. Leave empty to store files on local disk.
BLOB_READ_WRITE_TOKEN=
# Local-disk directory for uploads when Blob is not used (must be persistent storage)
UPLOAD_DIR=./uploads
# Max upload size in bytes (default 4 MB; Vercel limits request bodies to 4.5 MB)
UPLOAD_MAX_BYTES=4194304

# --- Optional: online payments (Razorpay) ----------------------------------
# Online payment stays unavailable until these are set AND enabled in Dashboard → Settings.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret for /api/payments/razorpay/webhook (event: payment.captured)
RAZORPAY_WEBHOOK_SECRET=

# --- Optional: email notifications (Resend) --------------------------------
RESEND_API_KEY=
# Verified sender, e.g. "VG Unisex Salon <bookings@yourdomain.in>"
EMAIL_FROM=

# --- Optional: appointment reminders ---------------------------------------
# Bearer secret for POST /api/cron/reminders (call every 15 minutes from a scheduler)
CRON_SECRET=

# --- Tests ------------------------------------------------------------------
# Separate database used (and dropped) by `npm test`
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/vg_saloon_test

# --- Owner setup (optional, avoids the interactive prompt) ------------------
# OWNER_PASSWORD=
